# Copy to .env and edit locally. Never commit the real .env.
# Initial backend: api or codex. The browser's saved selection takes precedence.
LLM_BACKEND=api
# Official native Codex CLI executable in PATH, or an absolute path to codex.exe.
# Run codex login in your terminal first. No API key is required for ChatGPT login.
CODEX_COMMAND=codex
# Leave empty to use the CLI default model (user config.toml is not loaded).
CODEX_MODEL=

# Any provider with a Chat Completions compatible endpoint can be used.
# Example local service: http://127.0.0.1:11434/v1 (a model name is still required).
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=

# Optional discovery services. Crossref and Open Library work without these.
OPENALEX_API_KEY=
BRAVE_SEARCH_API_KEY=
# Optional contact email used in the public metadata service User-Agent.
CONTACT_EMAIL=
